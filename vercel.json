{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/purchase-request",
      "destination": "/purchase-request.html"
    }
  ],
  "headers": [
    {
      "source": "/(dashboard.html|purchase-request.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
